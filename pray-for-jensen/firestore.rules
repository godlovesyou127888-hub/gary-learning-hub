rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function signed(){return request.auth != null;} function isAdmin(){return signed() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;} match /admins/{uid}{allow read: if signed() && request.auth.uid == uid; allow write: if false;} match /prayers/{id}{allow read: if resource.data.status == 'approved' || (signed() && resource.data.uid == request.auth.uid) || isAdmin(); allow create: if signed() && request.resource.data.keys().hasOnly(['uid','displayName','text','status','createdAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.text is string && request.resource.data.text.size() >= 2 && request.resource.data.text.size() <= 1000 && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 && request.resource.data.createdAt == request.time; allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedAt','reviewedBy']) && request.resource.data.status in ['approved','rejected'] && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time; allow delete: if isAdmin() || (signed() && resource.data.uid == request.auth.uid);} match /amens/{uid}{allow read: if true;allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','createdAt']) && request.resource.data.uid == uid && request.resource.data.createdAt == request.time;allow update,delete: if false;} match /subscriptions/{uid}{allow read,delete: if signed() && request.auth.uid == uid;allow create,update: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['uid','email','subscribed','updatedAt']) && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email && request.resource.data.subscribed == true && request.resource.data.updatedAt == request.time;} } }